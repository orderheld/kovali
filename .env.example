# KOVALI website: environment variables
# Copy to .env.local for local development. Never commit real values.
# In Vercel: Project Settings > Environment Variables.

# Public base URL (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.kovali.ch

# --- Contact form (Resend) -------------------------------------------------
# API key from https://resend.com/api-keys (permission "Sending access" is enough).
RESEND_API_KEY=
# Mailbox that receives contact requests.
CONTACT_TO_EMAIL=info@kovali.ch
# Sender on a domain verified in Resend, e.g. a subdomain like mail.kovali.ch.
CONTACT_FROM_EMAIL="KOVALI Website <website@mail.kovali.ch>"
# Random secret for hashing IP addresses (rate limiting). Generate with: openssl rand -hex 32
CONTACT_IP_SALT=
# true = log requests instead of sending them (local tests, preview deployments).
CONTACT_DRY_RUN=false

# --- Optional: Neon Postgres ----------------------------------------------
# Leave empty to deliver requests by email only. Schema: db/schema.sql
DATABASE_URL=
# Stored requests are deleted after this many days (cron /api/cron/retention).
CONTACT_RETENTION_DAYS=365
# Secret for the retention cron job. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Optional: Google Search Console ---------------------------------------
# Only needed for the HTML tag method; DNS verification via cyon is preferred.
GOOGLE_SITE_VERIFICATION=
